def main():
event_path = os.getenv('EVENT_PATH')
with open(event_path, 'r') as f:
event_data = json.load(f)
if 'issue' in event_data:
title = event_data['issue']['title']
body = event_data['issue']['body'] or ""
comments_url = event_data['issue']['comments_url']
elif 'pull_request' in event_data:
title = event_data['pull_request']['title']
body = event_data['pull_request']['body'] or ""
comments_url = event_data['pull_request']['comments_url']
else:
return
client = OpenAI(api_key=os.getenv('OPENAI_API_KEY'))
prompt = f"Analyze this GitHub request:\nTitle: {title}\nBody: {body}\n\nProvide a concise response:"
response = client.chat.completions.create(
model="gpt-4o-mini",
messages=[{"role": "user", "content": prompt}]
)
ai_reply = response.choices[0].message.content
headers = {
"Authorization": f"Bearer {os.getenv('GITHUB_TOKEN')}",
"Accept": "application/vnd.github+json"
}
requests.post(comments_url, json={"body": f"🤖 AI Agent Response:\n\n{ai_reply}"}, headers=headers)
if name == "main":
main()
